{
  "id": "ItemRow",
  "displayName": "아이템 행",
  "rowHeight": 36,
  "root": {
    "type": "panel",
    "children": [
      { "id": "icon",  "type": "icon",  "x": 4,  "y": 2, "bind": "iconIndex" },
      { "id": "name",  "type": "label", "x": 40, "y": 0, "text": "{$.name}" },
      { "id": "count", "type": "label", "x": 0,  "y": 0, "align": "right", "text": "{$.numberText}" }
    ]
  }
}
