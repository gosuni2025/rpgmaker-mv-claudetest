{
  "id": "status",
  "displayName": "캐릭터 상태",
  "formatVersion": 2,
  "prepareArgs": [],
  "initCtx": {
    "actorIndex": "$gameParty.menuActor() ? Math.max(0, $gameParty.members().indexOf($gameParty.menuActor())) : 0"
  },
  "keyHandlers": {
    "pagedown": {
      "action": "script",
      "code": "if(typeof SoundManager!=='undefined')SoundManager.playCursor(); $ctx.actorIndex = ($ctx.actorIndex + 1) % $gameParty.size();"
    },
    "pageup": {
      "action": "script",
      "code": "if(typeof SoundManager!=='undefined')SoundManager.playCursor(); $ctx.actorIndex = ($ctx.actorIndex - 1 + $gameParty.size()) % $gameParty.size();"
    },
    "cancel": {
      "action": "popScene"
    }
  },
  "navigation": {},
  "root": {
    "id": "root",
    "type": "panel",
    "x": 0,
    "y": 0,
    "width": 816,
    "height": 624,
