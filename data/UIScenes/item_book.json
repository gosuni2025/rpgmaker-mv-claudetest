        "id": "item_list",
        "type": "textList",
        "x": 0,
        "y": 0,
        "width": 240,
        "height": 624,
        "dataScript": "(function() {\n  var list = [];\n  var i, it;\n  for (i = 1; i < $dataItems.length; i++) {\n    it = $dataItems[i];\n    if (it && it.name && it.itypeId === 1 && it.meta.book !== 'no') {\n      var k = $gameSystem.isInItemBook(it);\n      list.push({\n        name: ('00' + (list.length + 1)).slice(-3) + '  ' + (k ? it.name : '??????'),\n        symbol: 'i_' + i,\n        data: it,\n        enabled: true\n      });\n    }\n  }\n  for (i = 1; i < $dataWeapons.length; i++) {\n    it = $dataWeapons[i];\n    if (it && it.name && it.meta.book !== 'no') {\n      var k2 = $gameSystem.isInItemBook(it);\n      list.push({\n        name: ('00' + (list.length + 1)).slice(-3) + '  ' + (k2 ? it.name : '??????'),\n        symbol: 'w_' + i,\n        data: it,\n        enabled: true\n      });\n    }\n  }\n  for (i = 1; i < $dataArmors.length; i++) {\n    it = $dataArmors[i];\n    if (it && it.name && it.meta.book !== 'no') {\n      var k3 = $gameSystem.isInItemBook(it);\n      list.push({\n        name: ('00' + (list.length + 1)).slice(-3) + '  ' + (k3 ? it.name : '??????'),\n        symbol: 'a_' + i,\n        data: it,\n        enabled: true\n      });\n    }\n  }\n  return list;\n})()",
        "onCursor": {
          "code": "var lst = this._widgetMap && this._widgetMap['item_list'];\nif (lst && lst._window) {\n  var idx = lst._window.index();\n  var cmds = lst._window._winDef.commands;\n  this._ctx = {\n    item: cmds && cmds[idx] ? cmds[idx].data : null\n  };\n}"
        },
        "handlers": {
          "cancel": {
            "action": "popScene"
          }
        }
      },
