        "dataScript": "(function(){var list=[];var i,it;for(i=1;i<$dataItems.length;i++){it=$dataItems[i];if(it&&it.name&&it.itypeId===1&&it.meta.book!=='no'){var k=$gameSystem.isInItemBook(it);list.push({name:('00'+(list.length+1)).slice(-3)+'  '+(k?it.name:'??????'),symbol:'i_'+i,data:it,enabled:true});}}for(i=1;i<$dataWeapons.length;i++){it=$dataWeapons[i];if(it&&it.name&&it.meta.book!=='no'){var k2=$gameSystem.isInItemBook(it);list.push({name:('00'+(list.length+1)).slice(-3)+'  '+(k2?it.name:'??????'),symbol:'w_'+i,data:it,enabled:true});}}for(i=1;i<$dataArmors.length;i++){it=$dataArmors[i];if(it&&it.name&&it.meta.book!=='no'){var k3=$gameSystem.isInItemBook(it);list.push({name:('00'+(list.length+1)).slice(-3)+'  '+(k3?it.name:'??????'),symbol:'a_'+i,data:it,enabled:true});}}return list;})()",
        "onCursor": {
          "code": "var lst=this._widgetMap&&this._widgetMap['item_list'];if(lst&&lst._window){var idx=lst._window.index();var cmds=lst._window._winDef.commands;this._ctx={item:cmds&&cmds[idx]?cmds[idx].data:null};}"
