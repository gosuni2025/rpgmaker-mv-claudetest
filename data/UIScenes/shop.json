{
  "id": "shop",
  "displayName": "상점",
  "formatVersion": 2,
  "prepareArgs": [
    "shopGoods",
    "purchaseOnly"
  ],
  "initCtx": {
    "shopGoods": "[]",
    "purchaseOnly": "false",
    "sellCategory": "'all'",
    "buyItems": "[]",
    "sellItems": "[]",
    "selectedItem": "null",
    "selectedPrice": "0",
    "shopMode": "'command'",
    "helpText": "''",
    "statusText": "''",
    "shopNum": "1",
    "shopMax": "1",
    "shopPrice": "0",
    "numInput": "false"
  },
  "navigation": {
    "defaultFocus": "cmd_win"
  },
  "onUpdate": "if ($ctx.numInput) { var changed = false; if (Input.isRepeated('up')) { $ctx.shopNum = Math.min($ctx.shopNum + 10, $ctx.shopMax); changed = true; } if (Input.isRepeated('down')) { $ctx.shopNum = Math.max($ctx.shopNum - 10, 1); changed = true; } if (Input.isRepeated('right')) { $ctx.shopNum = Math.min($ctx.shopNum + 1, $ctx.shopMax); changed = true; } if (Input.isRepeated('left')) { $ctx.shopNum = Math.max($ctx.shopNum - 1, 1); changed = true; } if (changed && typeof SoundManager !== 'undefined') SoundManager.playCursor(); }",
  "keyHandlers": {
    "ok": {
      "action": "script",
      "code": "if ($ctx.numInput) { SoundManager.playShop(); $ctx.numInput = false; this._widgetMap['number_win']._displayObject.visible = false; if ($ctx.shopMode === 'buy') { $gameParty.loseGold($ctx.shopNum * $ctx.shopPrice); $gameParty.gainItem($ctx.selectedItem, $ctx.shopNum); this._widgetMap['buy_list']._window.visible = true; this._navManager.focusWidget('buy_list'); } else { $gameParty.gainGold($ctx.shopNum * $ctx.shopPrice); $gameParty.loseItem($ctx.selectedItem, $ctx.shopNum); this._widgetMap['status_win']._displayObject.visible = false; this._widgetMap['sell_list']._window.visible = true; this._widgetMap['category_win']._window.visible = true; this._navManager.focusWidget('sell_list'); } }",
      "thenAction": {
        "action": "noop"
      }
    },
    "cancel": {
      "action": "script",
      "code": "if ($ctx.numInput) { SoundManager.playCancel(); $ctx.numInput = false; this._widgetMap['number_win']._displayObject.visible = false; if ($ctx.shopMode === 'buy') { this._widgetMap['buy_list']._window.visible = true; this._navManager.focusWidget('buy_list'); } else { this._widgetMap['status_win']._displayObject.visible = false; this._widgetMap['sell_list']._window.visible = true; this._widgetMap['category_win']._window.visible = true; this._navManager.focusWidget('sell_list'); } }",
      "thenAction": {
        "action": "noop"
      }
    }
  },
  "root": {
    "id": "root",
    "type": "panel",
    "x": 0,
    "y": 0,
    "width": 816,
    "height": 624,
    "windowed": false,
    "children": [
      {
        "id": "bg",
        "type": "background",
        "x": 0,
        "y": 0,
        "width": 816,
        "height": 624
      },
      {
        "id": "help_win",
        "type": "panel",
        "x": 0,
        "y": 0,
        "width": 816,
        "height": 72,
        "windowed": true,
        "children": [
          {
            "id": "help_text",
            "type": "textArea",
            "x": 4,
            "y": 6,
            "width": 800,
            "height": 60,
            "text": "{$ctx.helpText}",
            "fontSize": 22,
            "color": "#dddddd",
            "windowed": false
          }
        ]
      },
      {
        "id": "gold_win",
        "type": "panel",
        "x": 576,
        "y": 72,
        "width": 240,
        "height": 72,
        "windowed": true,
        "children": [
          {
            "id": "gold_label",
            "type": "label",
            "x": 8,
            "y": 4,
            "width": 224,
            "height": 48,
            "text": "{gold} {(function(){return typeof TextManager!=='undefined'?TextManager.currencyUnit:'G';})()}",
            "fontSize": 26,
            "align": "right",
            "color": "#dddddd",
            "windowed": false
          }
        ]
      },
      {
        "id": "cmd_win",
        "type": "textList",
        "x": 0,
        "y": 72,
        "width": 576,
        "height": 72,
        "maxCols": 3,
        "items": [
          {
            "name": "구매",
            "symbol": "buy",
            "enabled": true
          },
          {
            "name": "판매",
            "symbol": "sell",
            "enabledCondition": "!$ctx.purchaseOnly"
          },
          {
            "name": "취소",
            "symbol": "cancel",
            "enabled": true
          }
        ],
        "handlers": {
          "buy": {
            "action": "script",
            "code": "this._widgetMap['dummy_win']._displayObject.visible=false; this._widgetMap['buy_list']._window.visible=true; this._widgetMap['status_win']._displayObject.visible=true; $ctx.shopMode='buy'; $ctx.helpText=''; $ctx.statusText=''; this._navManager.focusWidget('buy_list');",
            "thenAction": {
              "action": "noop"
            }
          },
          "sell": {
            "action": "script",
            "code": "this._widgetMap['dummy_win']._displayObject.visible=false; this._widgetMap['category_win']._window.visible=true; this._widgetMap['sell_list']._window.visible=true; this._widgetMap['status_win']._displayObject.visible=false; $ctx.shopMode='sell'; $ctx.sellCategory='all'; $ctx.helpText=''; $ctx.statusText=''; this._navManager.focusWidget('category_win');",
            "thenAction": {
              "action": "noop"
            }
          },
          "cancel": {
            "action": "popScene"
          }
        }
      },
      {
        "id": "dummy_win",
        "type": "panel",
        "x": 0,
        "y": 144,
        "width": 816,
        "height": 480,
        "windowed": true
      },
      {
        "id": "buy_list",
        "type": "textList",
        "x": 0,
        "y": 144,
        "width": 456,
        "height": 480,
        "visible": false,
        "dataScript": "(function() {\n  var goods = $ctx.shopGoods || [];\n  var money = $gameParty.gold();\n  var items = [];\n  var itemData = [];\n  goods.forEach(function(g) {\n    var item = g[0] === 0 ? $dataItems[g[1]] : g[0] === 1 ? $dataWeapons[g[1]] : $dataArmors[g[1]];\n    if (item) {\n      var price = g[2] === 0 ? item.price : g[3];\n      items.push({\n        name: item.name,\n        symbol: 'buy',\n        iconIndex: item.iconIndex,\n        enabled: price <= money && !$gameParty.hasMaxItems(item),\n        numberText: String(price)\n      });\n      itemData.push({\n        item: item,\n        price: price\n      });\n    }\n  });\n  $ctx.buyItems = itemData;\n  return items;\n})()",
        "onCursor": {
          "code": "var win = this._widgetMap['buy_list']._window;\nvar idx = win.index();\nvar data = $ctx.buyItems;\nif (data && idx >= 0 && data[idx]) {\n  var info = data[idx];\n  $ctx.helpText = info.item.description;\n  $ctx.selectedItem = info.item;\n  $ctx.selectedPrice = info.price;\n  var cu = (typeof TextManager !== 'undefined' ? TextManager.currencyUnit : 'G');\n  $ctx.statusText = info.item.name + '\\n가격: ' + info.price + ' ' + cu;\n} else {\n  $ctx.helpText = '';\n  $ctx.selectedItem = null;\n  $ctx.statusText = '';\n}"
        },
        "handlers": {
          "ok": {
            "action": "script",
            "code": "var idx=this._widgetMap['buy_list']._window.index(); var info=$ctx.buyItems&&$ctx.buyItems[idx]; if(info){ $ctx.selectedItem=info.item; $ctx.selectedPrice=info.price; var maxBuy=Math.min($gameParty.maxItems(info.item)-$gameParty.numItems(info.item), info.price>0?Math.floor($gameParty.gold()/info.price):99); maxBuy=Math.max(1,maxBuy); $ctx.shopNum=1; $ctx.shopMax=maxBuy; $ctx.shopPrice=info.price; $ctx.numInput=true; this._widgetMap['buy_list']._window.visible=false; this._widgetMap['number_win']._displayObject.visible=true; this._navManager.clearFocus(); }",
            "thenAction": {
              "action": "noop"
            }
          },
          "cancel": {
            "action": "script",
            "code": "this._widgetMap['buy_list']._window.visible=false; this._widgetMap['status_win']._displayObject.visible=false; this._widgetMap['dummy_win']._displayObject.visible=true; $ctx.shopMode='command'; $ctx.helpText=''; $ctx.statusText=''; this._navManager.focusWidget('cmd_win');",
            "thenAction": {
              "action": "noop"
            }
          }
        }
      },
      {
        "id": "number_win",
        "type": "panel",
        "x": 0,
        "y": 144,
        "width": 456,
        "height": 480,
        "visible": false,
        "windowed": true,
        "children": [
          {
            "id": "num_item_name",
            "type": "label",
            "x": 8,
            "y": 8,
            "width": 440,
            "height": 36,
            "text": "{$ctx.selectedItem?$ctx.selectedItem.name:'-'}",
            "fontSize": 22,
            "align": "left",
            "color": "#dddddd",
            "windowed": false
          },
          {
            "id": "num_count",
            "type": "label",
            "x": 8,
            "y": 56,
            "width": 440,
            "height": 72,
            "text": "× {$ctx.shopNum}",
            "fontSize": 52,
            "align": "center",
            "color": "#ffffff",
            "windowed": false
          },
          {
            "id": "num_max_info",
            "type": "label",
            "x": 8,
            "y": 136,
            "width": 440,
            "height": 28,
            "text": "(최대 {$ctx.shopMax}개)",
            "fontSize": 18,
            "align": "center",
            "color": "#aaaaaa",
            "windowed": false
          },
          {
            "id": "num_total_title",
            "type": "label",
            "x": 8,
            "y": 178,
            "width": 220,
            "height": 36,
            "text": "소계",
            "fontSize": 22,
            "align": "left",
            "color": "#aaaaaa",
            "windowed": false
          },
          {
            "id": "num_total_amount",
            "type": "label",
            "x": 8,
            "y": 178,
            "width": 440,
            "height": 36,
            "text": "{(function(){var cu=typeof TextManager!=='undefined'?TextManager.currencyUnit:'G';return String(($ctx.shopNum||0)*($ctx.shopPrice||0))+' '+cu;})()}",
            "fontSize": 22,
            "align": "right",
            "color": "#dddddd",
            "windowed": false
          },
          {
            "id": "num_key_hint",
            "type": "label",
            "x": 8,
            "y": 230,
            "width": 440,
            "height": 30,
            "text": "↑↓: ±10개   ←→: ±1개",
            "fontSize": 18,
            "align": "center",
            "color": "#888888",
            "windowed": false
          },
          {
            "id": "num_confirm_hint",
            "type": "label",
            "x": 8,
            "y": 266,
            "width": 440,
            "height": 30,
            "text": "결정: 확인   취소: 돌아가기",
            "fontSize": 18,
            "align": "center",
            "color": "#888888",
            "windowed": false
          },
          {
            "id": "btn_down2",
            "type": "button",
            "x": 52, "y": 330, "width": 48, "height": 48,
            "label": "",
            "focusable": false,
            "windowed": false,
            "transition": "spriteSwap",
            "transitionConfig": {
              "normalImage": "ButtonSet",    "normalFrame":      [0, 0, 48, 48],
              "highlightedImage": "ButtonSet","highlightedFrame": [0, 0, 48, 48],
              "pressedImage": "ButtonSet",   "pressedFrame":     [0, 48, 48, 48]
            },
            "action": {
              "action": "script",
              "code": "$ctx.shopNum=Math.max($ctx.shopNum-10,1); SoundManager.playCursor();"
            }
          },
          {
            "id": "btn_down",
            "type": "button",
            "x": 116, "y": 330, "width": 48, "height": 48,
            "label": "",
            "focusable": false,
            "windowed": false,
            "transition": "spriteSwap",
            "transitionConfig": {
              "normalImage": "ButtonSet",    "normalFrame":      [48, 0, 48, 48],
              "highlightedImage": "ButtonSet","highlightedFrame": [48, 0, 48, 48],
              "pressedImage": "ButtonSet",   "pressedFrame":     [48, 48, 48, 48]
            },
            "action": {
              "action": "script",
              "code": "$ctx.shopNum=Math.max($ctx.shopNum-1,1); SoundManager.playCursor();"
            }
          },
          {
            "id": "btn_up",
            "type": "button",
            "x": 180, "y": 330, "width": 48, "height": 48,
            "label": "",
            "focusable": false,
            "windowed": false,
            "transition": "spriteSwap",
            "transitionConfig": {
              "normalImage": "ButtonSet",    "normalFrame":      [96, 0, 48, 48],
              "highlightedImage": "ButtonSet","highlightedFrame": [96, 0, 48, 48],
              "pressedImage": "ButtonSet",   "pressedFrame":     [96, 48, 48, 48]
            },
            "action": {
              "action": "script",
              "code": "$ctx.shopNum=Math.min($ctx.shopNum+1,$ctx.shopMax); SoundManager.playCursor();"
            }
          },
          {
            "id": "btn_up2",
            "type": "button",
            "x": 244, "y": 330, "width": 48, "height": 48,
            "label": "",
            "focusable": false,
            "windowed": false,
            "transition": "spriteSwap",
            "transitionConfig": {
              "normalImage": "ButtonSet",    "normalFrame":      [144, 0, 48, 48],
              "highlightedImage": "ButtonSet","highlightedFrame": [144, 0, 48, 48],
              "pressedImage": "ButtonSet",   "pressedFrame":     [144, 48, 48, 48]
            },
            "action": {
              "action": "script",
              "code": "$ctx.shopNum=Math.min($ctx.shopNum+10,$ctx.shopMax); SoundManager.playCursor();"
            }
          },
          {
            "id": "btn_ok",
            "type": "button",
            "x": 308, "y": 330, "width": 96, "height": 48,
            "label": "",
            "focusable": false,
            "windowed": false,
            "transition": "spriteSwap",
            "transitionConfig": {
              "normalImage": "ButtonSet",    "normalFrame":      [192, 0, 96, 48],
              "highlightedImage": "ButtonSet","highlightedFrame": [192, 0, 96, 48],
              "pressedImage": "ButtonSet",   "pressedFrame":     [192, 48, 96, 48]
            },
            "action": {
              "action": "script",
              "code": "SoundManager.playShop(); $ctx.numInput=false; this._widgetMap['number_win']._displayObject.visible=false; if($ctx.shopMode==='buy'){ $gameParty.loseGold($ctx.shopNum*$ctx.shopPrice); $gameParty.gainItem($ctx.selectedItem,$ctx.shopNum); this._widgetMap['buy_list']._window.visible=true; this._navManager.focusWidget('buy_list'); }else{ $gameParty.gainGold($ctx.shopNum*$ctx.shopPrice); $gameParty.loseItem($ctx.selectedItem,$ctx.shopNum); this._widgetMap['status_win']._displayObject.visible=false; this._widgetMap['sell_list']._window.visible=true; this._widgetMap['category_win']._window.visible=true; this._navManager.focusWidget('sell_list'); }"
            }
          }
        ]
      },
      {
        "id": "status_win",
        "type": "panel",
        "x": 456,
        "y": 144,
        "width": 360,
        "height": 480,
        "windowed": true,
        "visible": false,
        "children": [
          {
            "id": "status_text",
            "type": "textArea",
            "x": 8,
            "y": 8,
            "width": 336,
            "height": 472,
            "text": "{$ctx.statusText}",
            "fontSize": 22,
            "color": "#dddddd",
            "lineHeight": 32,
            "windowed": false
          }
        ]
      },
      {
        "id": "category_win",
        "type": "textList",
        "x": 0,
        "y": 144,
        "width": 816,
        "height": 72,
        "maxCols": 4,
        "visible": false,
        "items": [
          {
            "name": "아이템",
            "symbol": "item",
            "enabled": true
          },
          {
            "name": "무기",
            "symbol": "weapon",
            "enabled": true
          },
          {
            "name": "방어구",
            "symbol": "armor",
            "enabled": true
          },
          {
            "name": "중요 아이템",
            "symbol": "keyItem",
            "enabled": true
          }
        ],
        "handlers": {
          "ok": {
            "action": "script",
            "code": "var win=this._widgetMap['category_win']._window; $ctx.sellCategory=win.currentSymbol(); this._widgetMap['sell_list']._window.visible=true; this._widgetMap['sell_list'].refresh(); this._navManager.focusWidget('sell_list');",
            "thenAction": {
              "action": "noop"
            }
          },
          "cancel": {
            "action": "script",
            "code": "this._widgetMap['category_win']._window.visible=false; this._widgetMap['sell_list']._window.visible=false; this._widgetMap['dummy_win']._displayObject.visible=true; $ctx.shopMode='command'; $ctx.helpText=''; $ctx.statusText=''; this._navManager.focusWidget('cmd_win');",
            "thenAction": {
              "action": "noop"
            }
          }
        }
      },
      {
        "id": "sell_list",
        "type": "textList",
        "x": 0,
        "y": 216,
        "width": 816,
        "height": 408,
        "visible": false,
        "dataScript": "(function() {\n  var cat = $ctx.sellCategory || 'all';\n  var all = $gameParty.allItems();\n  var filtered = all.filter(function(item) {\n    if (!item || item.price <= 0) return false;\n    if (cat === 'item') return DataManager.isItem(item) && item.itypeId === 1;\n    if (cat === 'weapon') return DataManager.isWeapon(item);\n    if (cat === 'armor') return DataManager.isArmor(item);\n    if (cat === 'keyItem') return DataManager.isItem(item) && item.itypeId === 2;\n    return true;\n  });\n  $ctx.sellItems = filtered;\n  return filtered.map(function(item) {\n    return {\n      name: item.name,\n      symbol: 'sell',\n      iconIndex: item.iconIndex,\n      enabled: true,\n      numberText: String($gameParty.numItems(item))\n    };\n  });\n})()",
        "onCursor": {
          "code": "var win = this._widgetMap['sell_list']._window;\nvar idx = win.index();\nvar items = $ctx.sellItems;\nif (items && idx >= 0 && items[idx]) {\n  var item = items[idx];\n  var sellPrice = Math.floor(item.price / 2);\n  $ctx.helpText = item.description;\n  $ctx.selectedItem = item;\n  $ctx.selectedPrice = sellPrice;\n  var cu = (typeof TextManager !== 'undefined' ? TextManager.currencyUnit : 'G');\n  $ctx.statusText = item.name + '\\n판매가: ' + sellPrice + ' ' + cu;\n} else {\n  $ctx.helpText = '';\n  $ctx.selectedItem = null;\n  $ctx.statusText = '';\n  $ctx.selectedPrice = 0;\n}"
        },
        "handlers": {
          "ok": {
            "action": "script",
            "code": "var idx=this._widgetMap['sell_list']._window.index(); var items=$ctx.sellItems; var item=items&&items[idx]; if(item){ $ctx.selectedItem=item; $ctx.selectedPrice=Math.floor(item.price/2); var maxSell=$gameParty.numItems(item); $ctx.shopNum=1; $ctx.shopMax=maxSell; $ctx.shopPrice=$ctx.selectedPrice; $ctx.numInput=true; this._widgetMap['status_win']._displayObject.visible=true; this._widgetMap['sell_list']._window.visible=false; this._widgetMap['category_win']._window.visible=false; this._widgetMap['number_win']._displayObject.visible=true; this._navManager.clearFocus(); }",
            "thenAction": {
              "action": "noop"
            }
          },
          "cancel": {
            "action": "script",
            "code": "this._widgetMap['sell_list']._window.visible=false; this._navManager.focusWidget('category_win');",
            "thenAction": {
              "action": "noop"
            }
          }
        }
      }
    ]
  }
}