{
  "id": "title_sc",
  "displayName": "타이틀 화면 (커스텀)",
  "formatVersion": 2,
  "keyHandlers": {
    "cancel": {
      "action": "script",
      "code": "if(typeof SoundManager!=='undefined') SoundManager.playBuzzer();"
    }
  },
  "navigation": {
    "defaultFocus": "btn_newGame",
    "focusOrder": ["btn_newGame", "btn_continue", "btn_options", "btn_credit"],
    "upDownNavigation": true
  },
  "root": {
    "id": "root",
    "type": "panel",
    "x": 0,
    "y": 0,
    "width": 816,
    "height": 624,
    "windowed": false,
    "children": [
      {
        "id": "title_bg1",
        "type": "image",
        "x": 0,
        "y": 0,
        "width": 816,
        "height": 624,
        "bitmapExpr": "ImageManager.loadTitle1($dataSystem.title1Name)",
        "fitMode": "stretch"
      },
      {
        "id": "title_bg2",
        "type": "image",
        "x": 0,
        "y": 0,
        "width": 816,
        "height": 624,
        "bitmapExpr": "ImageManager.loadTitle2($dataSystem.title2Name)",
        "fitMode": "stretch"
      },
      {
        "id": "init",
        "type": "panel",
        "x": 0,
        "y": 0,
        "width": 0,
        "height": 0,
        "visible": false,
        "windowed": false,
        "scripts": {
          "onCreate": "SceneManager.clearStack(); AudioManager.playBgm($dataSystem.titleBgm); AudioManager.stopBgs(); AudioManager.stopMe();"
        },
        "children": []
      },
      {
        "id": "title_text",
        "type": "textArea",
        "x": 58,
        "y": 120,
        "width": 700,
        "height": 120,
        "text": "{$dataSystem.gameTitle}",
        "fontSize": 64,
        "align": "center",
        "color": "#ffffff",
        "outlineColor": "#000000",
        "outlineWidth": 6
      },
      {
        "id": "btn_newGame",
        "type": "button",
        "x": 288,
        "y": 340,
        "width": 240,
        "height": 52,
        "label": "{typeof TextManager!=='undefined'?TextManager.newGame:'새 게임'}",
        "windowed": true,
        "action": {
          "action": "script",
          "code": "DataManager.setupNewGame(); this.fadeOutAll(); SceneManager.goto(Scene_Map);"
        }
      },
      {
        "id": "btn_continue",
        "type": "button",
        "x": 288,
        "y": 404,
        "width": 240,
        "height": 52,
        "label": "{typeof TextManager!=='undefined'?TextManager.continue_:'이어하기'}",
        "windowed": true,
        "action": {
          "action": "script",
          "code": "if(DataManager.isAnySavefileExists()){SceneManager.push(Scene_Load);}else{if(typeof SoundManager!=='undefined')SoundManager.playBuzzer();}"
        }
      },
      {
        "id": "btn_options",
        "type": "button",
        "x": 288,
        "y": 468,
        "width": 240,
        "height": 52,
        "label": "{typeof TextManager!=='undefined'?TextManager.options:'옵션'}",
        "windowed": true,
        "action": {
          "action": "gotoScene",
          "target": "Scene_Options"
        }
      },
      {
        "id": "btn_credit",
        "type": "button",
        "x": 288,
        "y": 532,
        "width": 240,
        "height": 52,
        "label": "크레딧",
        "windowed": true,
        "action": {
          "action": "gotoScene",
          "target": "Scene_Credit"
        }
      }
    ]
  }
}
