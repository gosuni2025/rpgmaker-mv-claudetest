      {
        "type": "list",
        "id": "cmd_list",
        "x": 312,
        "y": 108,
        "width": 504,
        "height": 72,
        "maxCols": 3,
        "dataScript": "[{name:TextManager.equip2,symbol:'equip'},{name:TextManager.optimize,symbol:'optimize'},{name:TextManager.clear,symbol:'clear'}]",
        "handlers": {
          "equip": {
            "action": "script",
            "code": "$ctx.tempActor=null;$ctx.helpText='';var sw=this._widgetMap['slot_list'];if(sw&&sw._window){sw._rebuildFromScript();sw._window.activate();sw._window.select(0);$ctx.slotId=0;}"
          },
          "optimize": {
            "action": "script",
            "code": "var a=$gameParty.members()[$ctx.actorIndex];if(a){SoundManager.playEquip();a.optimizeEquipments();$ctx.tempActor=null;$ctx.helpText='';}this._rootWidget.refresh();"
          },
          "clear": {
            "action": "script",
            "code": "var a=$gameParty.members()[$ctx.actorIndex];if(a){SoundManager.playEquip();a.clearEquipments();$ctx.tempActor=null;$ctx.helpText='';}this._rootWidget.refresh();"
          },
          "cancel": {
            "action": "popScene"
          },
          "pagedown": {
            "action": "script",
            "code": "SoundManager.playCursor();$ctx.actorIndex=($ctx.actorIndex+1)%$gameParty.size();$ctx.tempActor=null;$ctx.helpText='';this._rootWidget.refresh();"
          },
          "pageup": {
            "action": "script",
            "code": "SoundManager.playCursor();$ctx.actorIndex=($ctx.actorIndex-1+$gameParty.size())%$gameParty.size();$ctx.tempActor=null;$ctx.helpText='';this._rootWidget.refresh();"
          }
        }
      },
      {
        "type": "list",
        "id": "slot_list",
        "x": 312,
        "y": 180,
        "width": 504,
        "height": 216,
        "focusable": true,
        "dataScript": "(function(){var a=$gameParty.members()[$ctx.actorIndex];if(!a)return [];return a.equipSlots().map(function(etypeId,i){var eq=a.equips()[i];return {name:'',symbol:'slot_'+i,enabled:a.isEquipChangeOk(i),data:i,cols:[{text:($dataSystem.equipTypes[etypeId]||''),width:138,color:8},{text:eq?eq.name:'',iconIndex:eq?(eq.iconIndex||0):0}]};});})()",
        "onCursor": {
          "code": "var sw=this._widgetMap['slot_list'];if(sw&&sw._window){$ctx.slotId=sw._window.index();$ctx.tempActor=null;$ctx.helpText='';var iw=this._widgetMap['item_list'];if(iw)iw._rebuildFromScript();}"
        },
        "handlers": {
          "ok": {
            "action": "script",
            "code": "var sw=this._widgetMap['slot_list'];if(!sw||!sw._window)return;$ctx.slotId=sw._window.index();var iw=this._widgetMap['item_list'];if(iw){iw._rebuildFromScript();iw._window.activate();iw._window.select(0);}"
          },
          "cancel": {
            "action": "script",
            "code": "var sw=this._widgetMap['slot_list'];if(sw&&sw._window)sw._window.deselect();var cw=this._widgetMap['cmd_list'];if(cw)cw.activate();"
          }
        }
      },
      {
        "type": "list",
        "id": "item_list",
        "x": 0,
        "y": 396,
        "width": 816,
        "height": 228,
        "focusable": true,
        "maxCols": 2,
        "dataScript": "(function(){var a=$gameParty.members()[$ctx.actorIndex];var slotId=$ctx.slotId||0;if(!a||!a.equipSlots)return [];var etypeId=a.equipSlots()[slotId];if(!etypeId)return [];var list=[{name:TextManager.none||'없음',symbol:'none',enabled:true,data:null}];$gameParty.equipItems().filter(function(it){return it.etypeId===etypeId&&a.canEquip(it);}).forEach(function(it){list.push({name:it.name,iconIndex:it.iconIndex,symbol:'eq_'+it.etypeId+'_'+it.id,enabled:true,data:it});});return list;})()",
        "onCursor": {
          "code": "var iw=this._widgetMap['item_list'];if(!iw||!iw._window)return;var cmds=iw._window._winDef.commands;var idx=iw._window.index();var item=cmds&&cmds[idx]?cmds[idx].data:null;var a=$gameParty.members()[$ctx.actorIndex];if(a){var tmp=JsonEx.makeDeepCopy(a);tmp.forceChangeEquip($ctx.slotId||0,item);$ctx.tempActor=tmp;}$ctx.helpText=item?item.description:(TextManager.none||'없음');this._rootWidget.refresh();"
        },
        "handlers": {
          "ok": {
            "action": "script",
            "code": "var iw=this._widgetMap['item_list'];if(!iw||!iw._window)return;var cmds=iw._window._winDef.commands;var idx=iw._window.index();var item=cmds&&cmds[idx]?cmds[idx].data:null;var a=$gameParty.members()[$ctx.actorIndex];if(a){SoundManager.playEquip();a.changeEquip($ctx.slotId||0,item);}$ctx.tempActor=null;$ctx.helpText='';var sw=this._widgetMap['slot_list'];if(sw){sw._rebuildFromScript();sw._window.activate();}iw._window.deselect();this._rootWidget.refresh();"
          },
          "cancel": {
            "action": "script",
            "code": "$ctx.tempActor=null;$ctx.helpText='';var iw=this._widgetMap['item_list'];if(iw&&iw._window)iw._window.deselect();var sw=this._widgetMap['slot_list'];if(sw)sw.activate();"
          }
        }
      },
