      {
        "type": "textList",
        "id": "cmd_list",
        "x": 312,
        "y": 108,
        "width": 504,
        "height": 72,
        "maxCols": 3,
        "dataScript": "[{\n  name: TextManager.equip2,\n  symbol: 'equip'\n}, {\n  name: TextManager.optimize,\n  symbol: 'optimize'\n}, {\n  name: TextManager.clear,\n  symbol: 'clear'\n}]",
        "handlers": {
          "equip": {
            "action": "script",
            "code": "$ctx.tempActor=null;$ctx.helpText='';var sw=this._widgetMap['slot_list'];if(sw&&sw._window){sw._rebuildFromScript();sw._window.activate();sw._window.select(0);$ctx.slotId=0;}"
          },
          "optimize": {
            "action": "script",
            "code": "var a=$gameParty.members()[$ctx.actorIndex];if(a){SoundManager.playEquip();a.optimizeEquipments();$ctx.tempActor=null;$ctx.helpText='';}this._rootWidget.refresh();"
          },
          "clear": {
            "action": "script",
            "code": "var a=$gameParty.members()[$ctx.actorIndex];if(a){SoundManager.playEquip();a.clearEquipments();$ctx.tempActor=null;$ctx.helpText='';}this._rootWidget.refresh();"
          },
          "cancel": {
            "action": "popScene"
          },
          "pagedown": {
            "action": "script",
            "code": "SoundManager.playCursor();$ctx.actorIndex=($ctx.actorIndex+1)%$gameParty.size();$ctx.tempActor=null;$ctx.helpText='';this._rootWidget.refresh();"
          },
          "pageup": {
            "action": "script",
            "code": "SoundManager.playCursor();$ctx.actorIndex=($ctx.actorIndex-1+$gameParty.size())%$gameParty.size();$ctx.tempActor=null;$ctx.helpText='';this._rootWidget.refresh();"
          }
        }
      },
      {
        "type": "textList",
        "id": "slot_list",
        "x": 312,
        "y": 180,
        "width": 504,
        "height": 216,
        "focusable": true,
        "dataScript": "(function() {\n  var a = $gameParty.members()[$ctx.actorIndex];\n  if (!a) return [];\n  return a.equipSlots().map(function(etypeId, i) {\n    var eq = a.equips()[i];\n    return {\n      name: '',\n      symbol: 'slot_' + i,\n      enabled: a.isEquipChangeOk(i),\n      data: i,\n      cols: [{\n        text: ($dataSystem.equipTypes[etypeId] || ''),\n        width: 138,\n        color: 8\n      }, {\n        text: eq ? eq.name : '',\n        iconIndex: eq ? (eq.iconIndex || 0) : 0\n      }]\n    };\n  });\n})()",
        "onCursor": {
          "code": "var sw = this._widgetMap['slot_list'];\nif (sw && sw._window) {\n  var sidx = sw._window.index();\n  if (sidx < 0) return;\n  $ctx.slotId = sidx;\n  $ctx.tempActor = null;\n  $ctx.helpText = '';\n  var iw = this._widgetMap['item_list'];\n  if (iw) iw._rebuildFromScript();\n}"
        },
        "handlers": {
          "ok": {
            "action": "script",
            "code": "var sw=this._widgetMap['slot_list'];if(!sw||!sw._window)return;$ctx.slotId=sw._window.index();var iw=this._widgetMap['item_list'];if(iw){iw._rebuildFromScript();iw._window.activate();iw._window.select(0);}"
          },
          "cancel": {
            "action": "script",
            "code": "var sw=this._widgetMap['slot_list'];if(sw&&sw._window)sw._window.deselect();var cw=this._widgetMap['cmd_list'];if(cw)cw.activate();"
          }
        }
      },
      {
        "type": "textList",
        "id": "item_list",
        "x": 0,
        "y": 396,
        "width": 816,
        "height": 228,
        "focusable": true,
        "maxCols": 2,
        "dataScript": "(function() {\n  var a = $gameParty.members()[$ctx.actorIndex];\n  var slotId = ($ctx.slotId >= 0 ? $ctx.slotId : 0);\n  if (!a || !a.equipSlots) return [];\n  var etypeId = a.equipSlots()[slotId];\n  if (!etypeId) return [];\n  var list = [{\n    name: TextManager.none || '없음',\n    symbol: 'none',\n    enabled: true,\n    data: null\n  }];\n  $gameParty.equipItems().filter(function(it) {\n    return it.etypeId === etypeId && a.canEquip(it);\n  }).forEach(function(it) {\n    list.push({\n      name: it.name,\n      iconIndex: it.iconIndex,\n      symbol: 'eq_' + it.etypeId + '_' + it.id,\n      enabled: true,\n      data: it\n    });\n  });\n  return list;\n})()",
        "onCursor": {
          "code": "var iw = this._widgetMap['item_list'];\nif (!iw || !iw._window) return;\nvar cmds = iw._window._winDef.commands;\nvar idx = iw._window.index();\nvar item = cmds && cmds[idx] ? cmds[idx].data : null;\nvar a = $gameParty.members()[$ctx.actorIndex];\nvar sid = ($ctx.slotId >= 0 ? $ctx.slotId : 0);\nif (a) {\n  var tmp = JsonEx.makeDeepCopy(a);\n  var newEquips = a._equips.map(function(eq, i) {\n    var gi = new Game_Item();\n    if (i === sid) { gi.setObject(item); }\n    else if (eq && eq._dataClass) { gi._dataClass = eq._dataClass; gi._itemId = eq._itemId || 0; }\n    return gi;\n  });\n  tmp._equips = newEquips;\n  $ctx.tempActor = tmp;\n}\n$ctx.helpText = item ? item.description : (TextManager.none || '없음');\nthis._rootWidget.refresh();"
        },
        "handlers": {
          "ok": {
            "action": "script",
            "code": "var iw=this._widgetMap['item_list'];if(!iw||!iw._window)return;var cmds=iw._window._winDef.commands;var idx=iw._window.index();var item=cmds&&cmds[idx]?cmds[idx].data:null;var a=$gameParty.members()[$ctx.actorIndex];if(a){SoundManager.playEquip();a.changeEquip(($ctx.slotId>=0?$ctx.slotId:0),item);}$ctx.tempActor=null;$ctx.helpText='';var sw=this._widgetMap['slot_list'];if(sw){sw._rebuildFromScript();sw._window.activate();}iw._window.deselect();this._rootWidget.refresh();"
          },
          "cancel": {
            "action": "script",
            "code": "$ctx.tempActor=null;$ctx.helpText='';var iw=this._widgetMap['item_list'];if(iw&&iw._window)iw._window.deselect();var sw=this._widgetMap['slot_list'];if(sw)sw.activate();"
          }
        }
