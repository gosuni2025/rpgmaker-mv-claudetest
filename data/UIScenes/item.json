{
  "id": "item",
  "displayName": "아이템",
  "formatVersion": 2,
  "prepareArgs": [],
  "initCtx": {
    "itemCategory": "item",
    "helpText": ""
  },
  "navigation": {
    "defaultFocus": "category_list",
    "cancelWidget": "category_list",
    "focusOrder": [
      "category_list",
      "item_list",
      "actor_select"
    ]
  },
  "root": {
    "id": "root",
    "type": "panel",
    "x": 0,
    "y": 0,
    "width": 816,
    "height": 624,
    "windowed": false,
    "children": [
      {
        "id": "bg",
        "type": "background",
        "x": 0,
        "y": 0,
        "width": 816,
        "height": 624
      },
      {
        "id": "help_win",
        "type": "panel",
        "x": 0,
        "y": 0,
        "width": 816,
        "height": 72,
        "windowed": true,
        "children": [
          {
            "id": "help_text",
            "type": "textArea",
            "x": 6,
            "y": 6,
            "width": 780,
            "height": 60,
            "text": "{$ctx.helpText}",
            "fontSize": 22,
            "verticalAlign": "middle"
          }
        ]
      },
      {
        "id": "category_list",
        "type": "list",
        "x": 0,
        "y": 72,
        "width": 816,
        "height": 72,
        "maxCols": 4,
        "items": [
          {
            "name": "{TextManager.item}",
            "symbol": "item",
            "enabled": true
          },
          {
            "name": "{TextManager.weapon}",
            "symbol": "weapon",
            "enabled": true
          },
          {
            "name": "{TextManager.armor}",
            "symbol": "armor",
            "enabled": true
          },
          {
            "name": "{TextManager.keyItem}",
            "symbol": "keyItem",
            "enabled": true
          }
        ],
        "onCursor": {
          "code": "var w=this._widgetMap['category_list'];var idx=w&&w._window?w._window.index():-1;var cmds=w&&w._window?w._window._winDef.commands:null;var sym=cmds&&cmds[idx]?cmds[idx].symbol:null;if(sym&&this._ctx.itemCategory!==sym){this._ctx.itemCategory=sym;var il=this._widgetMap['item_list'];if(il&&il._rebuildFromScript)il._rebuildFromScript();}"
        },
        "handlers": {
          "item": {
            "action": "script",
            "code": "$ctx.itemCategory='item';",
            "thenAction": {
              "action": "focusWidget",
              "target": "item_list"
            }
          },
          "weapon": {
            "action": "script",
            "code": "$ctx.itemCategory='weapon';",
            "thenAction": {
              "action": "focusWidget",
              "target": "item_list"
            }
          },
          "armor": {
            "action": "script",
            "code": "$ctx.itemCategory='armor';",
            "thenAction": {
              "action": "focusWidget",
              "target": "item_list"
            }
          },
          "keyItem": {
            "action": "script",
            "code": "$ctx.itemCategory='keyItem';",
            "thenAction": {
              "action": "focusWidget",
              "target": "item_list"
            }
          },
          "cancel": {
            "action": "popScene"
          }
        }
      },
      {
        "id": "item_list",
        "type": "list",
        "x": 0,
        "y": 144,
        "width": 816,
        "height": 480,
        "maxCols": 2,
        "dataScript": "(function(){var cat=($ctx&&$ctx.itemCategory)||'item';var items=[];if(cat==='item'){items=($gameParty&&$gameParty.items()||[]).filter(function(i){return DataManager.isItem(i)&&i.itypeId===1;});}else if(cat==='weapon'){items=$gameParty&&$gameParty.weapons()||[];}else if(cat==='armor'){items=$gameParty&&$gameParty.armors()||[];}else if(cat==='keyItem'){items=($gameParty&&$gameParty.items()||[]).filter(function(i){return DataManager.isItem(i)&&i.itypeId===2;});}return items.map(function(item){return{name:item.name,iconIndex:item.iconIndex,numberText:'×'+$gameParty.numItems(item),symbol:'item_'+item.id,enabled:$gameParty.canUse(item),data:item};});})()",
        "onCursor": {
          "code": "var w=this._widgetMap&&this._widgetMap['item_list'];var idx=w&&w._window?w._window.index():-1;var cmd=idx>=0?(w._window._winDef.commands&&w._window._winDef.commands[idx]):null;this._ctx.helpText=(cmd&&cmd.data&&cmd.data.description)?cmd.data.description:'';"
        },
        "handlers": {
          "ok": {
            "action": "useItem",
            "itemListWidget": "item_list",
            "actorWidget": "actor_select"
          },
          "cancel": {
            "action": "focusWidget",
            "target": "category_list"
          }
        }
      },
      {
        "id": "actor_select",
        "type": "rowSelector",
        "x": 0,
        "y": 144,
        "width": 816,
        "height": 480,
        "numRows": "party",
        "transparent": true,
        "padding": 0,
        "handlers": {
          "cancel": {
            "action": "focusWidget",
            "target": "item_list"
          }
        }
      }
    ]
  }
}