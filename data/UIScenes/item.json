{
  "id": "item",
  "displayName": "아이템",
  "formatVersion": 2,
  "prepareArgs": [],
  "initCtx": {
    "itemCategory": "item",
    "helpText": ""
  },
  "navigation": {
    "defaultFocus": "category_list",
    "cancelWidget": "category_list",
    "focusOrder": [
      "category_list",
      "item_list",
      "actor_list",
      "id_action",
      "id_popup_ctrl",
      "id_full_ctrl"
    ]
  },
  "root": {
    "id": "root",
    "type": "panel",
    "x": 0,
    "y": 0,
    "width": 816,
    "height": 624,
    "windowed": false,
    "children": [
      {
        "id": "bg",
        "type": "background",
        "x": 0,
        "y": 0,
        "width": 816,
        "height": 624
      },
      {
        "id": "help_win",
        "type": "panel",
        "x": 0,
        "y": 0,
        "width": 816,
        "height": 72,
        "windowed": true,
        "children": [
          {
            "id": "help_text",
            "type": "textArea",
            "x": 6,
            "y": 6,
            "width": 780,
            "height": 60,
            "text": "{$ctx.helpText}",
            "fontSize": 22,
            "verticalAlign": "middle"
          }
        ]
      },
      {
        "id": "category_list",
        "type": "textList",
        "x": 0,
        "y": 72,
        "width": 816,
        "height": 72,
        "maxCols": 4,
        "items": [
          {
            "name": "{TextManager.item}",
            "symbol": "item",
            "enabled": true
          },
          {
            "name": "{TextManager.weapon}",
            "symbol": "weapon",
            "enabled": true
          },
          {
            "name": "{TextManager.armor}",
            "symbol": "armor",
            "enabled": true
          },
          {
            "name": "{TextManager.keyItem}",
            "symbol": "keyItem",
            "enabled": true
          }
        ],
        "onCursor": {
          "code": "var w = this._widgetMap['category_list'];\nvar idx = w && w._window ? w._window.index() : -1;\nvar cmds = w && w._window ? w._window._winDef.commands : null;\nvar sym = cmds && cmds[idx] ? cmds[idx].symbol : null;\nif (sym && this._ctx.itemCategory !== sym) {\n  this._ctx.itemCategory = sym;\n  var il = this._widgetMap['item_list'];\n  if (il && il._rebuildFromScript) il._rebuildFromScript();\n}"
        },
        "handlers": {
          "item": {
            "action": "script",
            "code": "$ctx.itemCategory='item';",
            "thenAction": {
              "action": "focusWidget",
              "target": "item_list"
            }
          },
          "weapon": {
            "action": "script",
            "code": "$ctx.itemCategory='weapon';",
            "thenAction": {
              "action": "focusWidget",
              "target": "item_list"
            }
          },
          "armor": {
            "action": "script",
            "code": "$ctx.itemCategory='armor';",
            "thenAction": {
              "action": "focusWidget",
              "target": "item_list"
            }
          },
          "keyItem": {
            "action": "script",
            "code": "$ctx.itemCategory='keyItem';",
            "thenAction": {
              "action": "focusWidget",
              "target": "item_list"
            }
          },
          "cancel": {
            "action": "popScene"
          }
        }
      },
      {
        "id": "item_list",
        "type": "list",
        "x": 0,
        "y": 144,
        "width": 816,
        "height": 480,
        "maxCols": 2,
        "itemScene": "item_row",
        "dataScript": "(function() {\n  var cat = ($ctx && $ctx.itemCategory) || 'item';\n  var items = [];\n  if (cat === 'item') {\n    items = ($gameParty && $gameParty.items() || []).filter(function(i) {\n      return DataManager.isItem(i) && i.itypeId === 1;\n    });\n  } else if (cat === 'weapon') {\n    items = $gameParty && $gameParty.weapons() || [];\n  } else if (cat === 'armor') {\n    items = $gameParty && $gameParty.armors() || [];\n  } else if (cat === 'keyItem') {\n    items = ($gameParty && $gameParty.items() || []).filter(function(i) {\n      return DataManager.isItem(i) && i.itypeId === 2;\n    });\n  }\n  return items.map(function(item) {\n    return {\n      name: item.name,\n      iconIndex: item.iconIndex,\n      numberText: '×' + $gameParty.numItems(item),\n      symbol: 'item_' + item.id,\n      enabled: $gameParty.canUse(item) || !!(item.note && (item.note.indexOf('<detailPic>') >= 0 || item.note.indexOf('<detailTxt>') >= 0)),\n      data: item\n    };\n  });\n})()",
        "onCursor": {
          "code": "var w = this._widgetMap && this._widgetMap['item_list'];\nvar idx = w && w._window ? w._window.index() : -1;\nvar cmd = idx >= 0 ? (w._window._winDef.commands && w._window._winDef.commands[idx]) : null;\nthis._ctx.helpText = (cmd && cmd.data && cmd.data.description) ? cmd.data.description : '';\nthis._ctx.selectedItem = (cmd && cmd.data) ? cmd.data : null;"
        },
        "handlers": {
          "ok": {
            "action": "useItem",
            "itemListWidget": "item_list",
            "actorWidget": "actor_list"
          },
          "cancel": {
            "action": "focusWidget",
            "target": "category_list"
          }
        }
      },
      {
        "id": "actor_list",
        "type": "list",
        "x": 0,
        "y": 144,
        "width": 816,
        "height": 480,
        "itemScene": "actor_row_item",
        "rowHeight": 120,
        "padding": 0,
        "visible": false,
        "dataScript": "$gameParty.members().map(function(a, i) { return { actorIndex: i }; })"
      },
      {
        "id": "id_action",
        "displayName": "사용/살펴보기 선택",
        "type": "textList",
        "topLayer": true,
        "visible": false,
        "x": 288,
        "y": 258,
        "width": 240,
        "height": 108,
        "maxCols": 2,
        "items": [
          {
            "text": "사용",
            "symbol": "use"
          },
          {
            "text": "살펴보기",
            "symbol": "inspect"
          }
        ],
        "handlers": {
          "ok": {
            "action": "script",
            "code": "var aw=this._widgetMap['id_action'];var sym=aw&&aw._window?aw._window.currentSymbol():null;aw.displayObject().visible=false;if(sym==='use'){if(this._execPendingUse)this._execPendingUse();}else{var item=this._ctx.selectedItem;var detailD={image:null,text:''};if(item&&item.note){var pm=item.note.match(/<detailPic>([\\s\\S]*?)<\\/detailPic>/);if(pm){try{var pd=JSON.parse(pm[1]);detailD.image=pd.image||null;}catch(e){}}var tm=item.note.match(/<detailTxt>([\\s\\S]*?)<\\/detailTxt>/);if(tm){try{var td=JSON.parse(tm[1]);detailD.text=td.text||'';}catch(e){}}}this._ctx._detailD=detailD;var pp=this._widgetMap['id_popup'];var pc=this._widgetMap['id_popup_ctrl'];if(pp)pp.displayObject().visible=true;if(pc)pc.displayObject().visible=true;var img=this._widgetMap['id_popup_img'];if(img&&img.refresh)img.refresh();var txt=this._widgetMap['id_popup_text'];if(txt&&txt.refresh)txt.refresh();if(this._navManager)this._navManager.focusWidget('id_popup_ctrl');}"
          },
          "cancel": {
            "action": "script",
            "code": "this._widgetMap['id_action'].displayObject().visible=false;",
            "thenAction": {
              "action": "focusWidget",
              "target": "item_list"
            }
          }
        }
      },
      {
        "id": "id_popup",
        "displayName": "상세 팝업",
        "type": "panel",
        "topLayer": true,
        "visible": false,
        "x": 0,
        "y": 0,
        "width": 816,
        "height": 624,
        "windowed": false,
        "bgColor": "rgba(0,0,0,0.7)",
        "children": [
          {
            "id": "id_popup_win",
            "type": "panel",
            "x": 33,
            "y": 25,
            "width": 750,
            "height": 502,
            "windowed": true,
            "children": [
              {
                "id": "id_popup_img",
                "type": "image",
                "x": 18,
                "y": 18,
                "width": 357,
                "height": 466,
                "bitmapExpr": "$ctx._detailD&&$ctx._detailD.image?ImageManager.loadPicture($ctx._detailD.image):null",
                "fitMode": "contain"
              },
              {
                "id": "id_popup_text",
                "type": "textArea",
                "x": 379,
                "y": 18,
                "width": 353,
                "height": 466,
                "useTextEx": true,
                "text": "{$ctx._detailD&&$ctx._detailD.text||\"\"}"
              }
            ]
          }
        ]
      },
      {
        "id": "id_popup_ctrl",
        "displayName": "상세 팝업 컨트롤",
        "type": "textList",
        "topLayer": true,
        "visible": false,
        "x": 33,
        "y": 527,
        "width": 750,
        "height": 72,
        "maxCols": 2,
        "items": [
          {
            "text": "자세히 보기",
            "symbol": "view"
          },
          {
            "text": "닫기",
            "symbol": "close"
          }
        ],
        "handlers": {
          "ok": {
            "action": "script",
            "code": "var w=this._widgetMap['id_popup_ctrl'];var sym=w&&w._window?w._window.currentSymbol():null;if(sym==='view'){var d=this._ctx._detailD;if(d&&d.image){SoundManager.playOk();var fp=this._widgetMap['id_fullscreen'];var fc=this._widgetMap['id_full_ctrl'];if(fp)fp.displayObject().visible=true;if(fc)fc.displayObject().visible=true;var img=this._widgetMap['id_full_img'];if(img&&img.refresh)img.refresh();if(this._navManager)this._navManager.focusWidget('id_full_ctrl');}else SoundManager.playBuzzer();}else{var pp=this._widgetMap['id_popup'];var pc=this._widgetMap['id_popup_ctrl'];if(pp)pp.displayObject().visible=false;if(pc)pc.displayObject().visible=false;if(this._navManager)this._navManager.focusWidget('item_list');}"
          },
          "cancel": {
            "action": "script",
            "code": "var pp=this._widgetMap['id_popup'];var pc=this._widgetMap['id_popup_ctrl'];if(pp)pp.displayObject().visible=false;if(pc)pc.displayObject().visible=false;",
            "thenAction": {
              "action": "focusWidget",
              "target": "item_list"
            }
          }
        }
      },
      {
        "id": "id_fullscreen",
        "displayName": "전체화면 이미지",
        "type": "panel",
        "topLayer": true,
        "visible": false,
        "x": 0,
        "y": 0,
        "width": 816,
        "height": 624,
        "windowed": false,
        "bgAlpha": 0.9,
        "children": [
          {
            "id": "id_full_img",
            "type": "image",
            "x": 0,
            "y": 0,
            "width": 816,
            "height": 624,
            "bitmapExpr": "$ctx._detailD&&$ctx._detailD.image?ImageManager.loadPicture($ctx._detailD.image):null",
            "fitMode": "contain"
          }
        ]
      },
      {
        "id": "id_full_ctrl",
        "displayName": "전체화면 컨트롤",
        "type": "textList",
        "topLayer": true,
        "visible": false,
        "x": 0,
        "y": -100,
        "width": 816,
        "height": 1,
        "items": [],
        "bgAlpha": 0,
        "handlers": {
          "cancel": {
            "action": "script",
            "code": "SoundManager.playCancel();var fp=this._widgetMap['id_fullscreen'];var fc=this._widgetMap['id_full_ctrl'];if(fp)fp.displayObject().visible=false;if(fc)fc.displayObject().visible=false;",
            "thenAction": {
              "action": "focusWidget",
              "target": "id_popup_ctrl"
            }
          }
        }
      }
    ],
    "enterAnimation": {
      "type": "fade",
      "duration": 15,
      "delay": 0
    }
  }
}