{
  "id": "fj_classChange",
  "displayName": "전직 시스템",
  "formatVersion": 2,
  "prepareArgs": [],
  "navigation": {
    "defaultFocus": "actor_list",
    "cancelWidget": "actor_list",
    "focusOrder": [
      "actor_list",
      "slot_list",
      "class_list"
    ]
  },
  "root": {
    "id": "root",
    "type": "panel",
    "x": 0,
    "y": 0,
    "width": 816,
    "height": 624,
    "windowed": false,
    "children": [
      {
        "id": "bg",
        "type": "background",
        "x": 0,
        "y": 0,
        "width": 816,
        "height": 624
      },
      {
        "id": "left_panel",
        "type": "panel",
        "x": 0,
        "y": 0,
        "width": 248,
        "height": 624,
        "windowed": true,
        "children": [
          {
            "id": "fj_title",
            "type": "label",
            "x": 6,
            "y": 6,
            "width": 236,
            "height": 36,
            "text": "◆ 전직 시스템",
            "fontSize": 22
          },
          {
            "id": "fj_actor_name",
            "type": "label",
            "x": 6,
            "y": 46,
            "width": 236,
            "height": 28,
            "text": "{FJ.actorName()}",
            "fontSize": 18,
            "color": "#aaaaaa"
          },
          {
            "id": "fj_slot_sep2",
            "type": "label",
            "x": 6,
            "y": 194,
            "width": 236,
            "height": 22,
            "text": "── 슬롯 선택 ──",
            "fontSize": 15,
            "color": "#888888",
            "align": "center"
          }
        ]
      },
      {
        "id": "actor_list",
        "type": "textList",
        "x": 0,
        "y": 72,
        "width": 248,
        "height": 144,
        "windowed": false,
        "dataScript": "FJ.actorItems()",
        "onCursor": {
          "code": "var lw = this._widgetMap['actor_list'];\nif (lw && lw._window && lw._window.active) {\n  var sym = lw._window.currentSymbol();\n  if (sym) {\n    var idx = parseInt(sym.replace('actor_', ''), 10);\n    FJ._actorIdx = idx;\n    FJ._slot = 0;\n    FJ._curClassId = 0;\n    var sl = this._widgetMap['slot_list'];\n    if (sl && sl._rebuildFromScript) sl._rebuildFromScript();\n  }\n}"
        },
        "handlers": {
          "ok": {
            "action": "script",
            "code": "FJ._curClassId=0;",
            "thenAction": {
              "action": "focusWidget",
              "target": "slot_list"
            }
          },
          "cancel": {
            "action": "popScene"
          }
        }
      },
      {
        "id": "slot_list",
        "type": "textList",
        "x": 0,
        "y": 216,
        "width": 248,
        "height": 408,
        "windowed": false,
        "dataScript": "FJ.slotItems()",
        "onCursor": {
          "code": "var lw = this._widgetMap[\"slot_list\"];\nif (lw && lw._window && lw._window.active) {\n  var sym = lw._window.currentSymbol();\n  FJ._slot = sym ? parseInt(sym.replace(\"slot_\", \"\"), 10) : 0;\n  FJ._curClassId = 0;\n  var cl = this._widgetMap[\"class_list\"];\n  if (cl && cl._rebuildFromScript) cl._rebuildFromScript();\n}"
        },
        "handlers": {
          "ok": {
            "action": "script",
            "code": "FJ._curClassId=0;",
            "thenAction": {
              "action": "focusWidget",
              "target": "class_list"
            }
          },
          "cancel": {
            "action": "popScene"
          }
        }
      },
      {
        "id": "center_panel",
        "type": "panel",
        "x": 248,
        "y": 0,
        "width": 270,
        "height": 624,
        "windowed": true,
        "children": [
          {
            "id": "fj_class_title",
            "type": "label",
            "x": 6,
            "y": 6,
            "width": 258,
            "height": 36,
            "text": "직업 목록",
            "fontSize": 22
          }
        ]
      },
      {
        "id": "class_list",
        "type": "textList",
        "x": 248,
        "y": 44,
        "width": 270,
        "height": 580,
        "windowed": false,
        "dataScript": "FJ.classItems()",
        "onCursor": {
          "code": "var lw = this._widgetMap['class_list'];\nif (lw && lw._window && lw._window.active) {\n  var sym = lw._window.currentSymbol();\n  FJ._curClassId = sym ? parseInt(sym.replace('cls_', ''), 10) : 0;\n}"
        },
        "handlers": {
          "ok": {
            "action": "script",
            "code": "FJ.applySlotChange();",
            "thenAction": {
              "action": "focusWidget",
              "target": "slot_list"
            }
          },
          "cancel": {
            "action": "focusWidget",
            "target": "slot_list"
          }
        },
        "rowHeight": 72,
        "autoRefresh": false
      },
