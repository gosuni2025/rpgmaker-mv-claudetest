          {
            "name": "게임 종료",
            "symbol": "gameEnd",
            "enabled": true
          }
        ],
        "handlers": {
          "item": {
            "action": "gotoScene",
            "target": "Scene_CS_item"
          },
          "skill": {
            "action": "selectActor",
            "widget": "actor_select",
            "thenAction": {
              "action": "gotoScene",
              "target": "Scene_CS_fj_skillLearn"
            }
          },
          "equip": {
            "action": "selectActor",
            "widget": "actor_select",
            "thenAction": {
              "action": "gotoScene",
              "target": "Scene_CS_equip"
            }
          },
          "status": {
            "action": "selectActor",
            "widget": "actor_select",
            "thenAction": {
              "action": "gotoScene",
              "target": "Scene_CS_status"
            }
          },
          "formation": {
            "action": "formation",
            "widget": "actor_select"
          },
          "options": {
            "action": "gotoScene",
            "target": "Scene_CS_options"
          },
          "save": {
            "action": "gotoScene",
            "target": "Scene_CS_save"
          },
          "gameEnd": {
            "action": "gotoScene",
            "target": "Scene_CS_gameEnd"
          },
          "cancel": {
            "action": "popScene"
          }
        }
