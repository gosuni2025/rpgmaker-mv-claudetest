{
  "id": "menu_v2",
  "displayName": "게임 메뉴",
  "formatVersion": 2,
  "prepareArgs": [],
  "navigation": {
    "defaultFocus": "cmd_main",
    "cancelWidget": "cmd_main",
    "focusOrder": [
      "cmd_main",
      "actor_list"
    ]
  },
  "root": {
    "id": "root",
    "type": "panel",
    "x": 0,
    "y": 0,
    "width": 816,
    "height": 624,
    "windowed": false,
    "children": [
      {
        "id": "bg",
        "type": "background",
        "x": 0,
        "y": 0,
        "width": 816,
        "height": 624
      },
      {
        "id": "cmd_main",
        "type": "textList",
        "x": 0,
        "y": 0,
        "width": 240,
        "maxCols": 1,
        "items": [
          {
            "name": "아이템",
            "symbol": "item",
            "enabled": true
          },
          {
            "name": "스킬",
            "symbol": "skill",
            "enabled": true
          },
          {
            "name": "장비",
            "symbol": "equip",
            "enabled": true
          },
          {
            "name": "상태",
            "symbol": "status",
            "enabled": true
          },
          {
            "name": "대형",
            "symbol": "formation",
            "enabledCondition": "$gameParty.size() >= 2 && $gameSystem.isFormationEnabled()"
          },
          {
            "name": "옵션",
            "symbol": "options",
            "enabled": true
          },
          {
            "name": "세이브",
            "symbol": "save",
            "enabledCondition": "$gameSystem.isSaveEnabled()"
          },
          {
            "name": "네비게이션 테스트",
            "symbol": "navTest",
            "enabled": true
          },
          {
            "name": "스크립트 테스트",
            "symbol": "scriptTest",
            "enabled": true
          },
          {
            "name": "게임 종료",
            "symbol": "gameEnd",
            "enabled": true
          }
        ],
        "handlers": {
          "item": {
            "action": "gotoScene",
            "target": "Scene_CS_item"
          },
          "skill": {
            "action": "selectActor",
            "widget": "actor_list",
            "thenAction": {
              "action": "gotoScene",
              "target": "Scene_CS_skill"
            }
          },
          "equip": {
            "action": "selectActor",
            "widget": "actor_list",
            "thenAction": {
              "action": "gotoScene",
              "target": "Scene_CS_equip"
            }
          },
          "status": {
            "action": "selectActor",
            "widget": "actor_list",
            "thenAction": {
              "action": "gotoScene",
              "target": "Scene_CS_status"
            }
          },
          "formation": {
            "action": "formation",
            "widget": "actor_list"
          },
          "options": {
            "action": "gotoScene",
            "target": "Scene_CS_options"
          },
          "save": {
            "action": "gotoScene",
            "target": "Scene_CS_save"
          },
          "navTest": {
            "action": "customScene",
            "target": "navTest"
          },
          "scriptTest": {
            "action": "customScene",
            "target": "scriptTest"
          },
          "gameEnd": {
            "action": "gotoScene",
            "target": "Scene_CS_gameEnd"
          },
          "cancel": {
            "action": "popScene"
          }
        }
      },
      {
        "id": "gold_win",
        "type": "panel",
        "x": 0,
        "y": 552,
        "width": 240,
        "height": 72,
        "windowed": true,
        "children": [
          {
            "id": "gold_label",
            "type": "label",
            "x": 6,
            "y": 6,
            "width": 192,
            "height": 36,
            "text": "{gold}G",
            "align": "right"
          }
        ]
      },
      {
        "id": "party_panel",
        "type": "panel",
        "x": 240,
        "y": 0,
        "width": 576,
        "height": 624,
        "windowed": true,
        "children": [
          {
            "id": "actor_list",
            "type": "list",
            "x": 0,
            "y": 0,
            "width": 576,
            "height": 624,
            "itemScene": "actor_row",
            "dataScript": "$gameParty.members().map(function(a, i) { return { actorIndex: i }; })"
          }
        ]
      },
      {
        "id": "textArea_17722543123303",
        "type": "textArea",
        "x": 17,
        "y": 404,
        "width": 300,
        "height": 80,
        "text": "커스텀씬",
        "align": "center",
        "verticalAlign": "middle"
      }
    ]
  }
}