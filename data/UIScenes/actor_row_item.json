        "y": 8,
        "width": 100,
        "height": 100
      },
      {
        "id": "name",
        "type": "label",
        "x": 110,
        "y": 8,
        "width": 220,
        "height": 34,
        "text": "{actor[$ctx.actorIndex].name}",
        "fontSize": 26
      },
      {
        "id": "class",
