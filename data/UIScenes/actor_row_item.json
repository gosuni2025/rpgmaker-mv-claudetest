{
  "id": "actor_row_item",
  "displayName": "액터 행 (아이템 선택용)",
  "formatVersion": 2,
  "root": {
    "id": "actor_row_item_root",
    "type": "panel",
    "x": 0,
    "y": 0,
    "width": 816,
    "height": 120,
    "windowed": false,
    "children": [
      {
        "id": "face",
        "type": "image",
