        "width": 240,
        "height": 624,
        "dataScript": "(function() {\n  var list = [];\n  for (var i = 1; i < $dataEnemies.length; i++) {\n    var e = $dataEnemies[i];\n    if (e && e.name && e.meta.book !== 'no') {\n      var known = $gameSystem.isInEnemyBook(e);\n      list.push({\n        name: ('00' + (list.length + 1)).slice(-3) + '  ' + (known ? e.name : '??????'),\n        symbol: 'enemy_' + i,\n        data: e,\n        enabled: true\n      });\n    }\n  }\n  return list;\n})()",
        "onCursor": {
          "code": "var lst = this._widgetMap && this._widgetMap['enemy_list'];\nif (lst && lst._window) {\n  var idx = lst._window.index();\n  var cmds = lst._window._winDef.commands;\n  this._ctx = {\n    enemy: cmds && cmds[idx] ? cmds[idx].data : null\n  };\n}"
