{
  "scenes": {
    "menu_v2": {
      "id": "menu_v2",
      "displayName": "위젯 트리 메뉴 (v2)",
      "baseScene": "MenuBase",
      "formatVersion": 2,
      "prepareArgs": [],
      "navigation": {
        "defaultFocus": "cmd_main",
        "cancelWidget": "cmd_main",
        "focusOrder": [
          "cmd_main"
        ]
      },
      "root": {
        "id": "root",
        "type": "panel",
        "x": 0,
        "y": 0,
        "width": 816,
        "height": 624,
        "windowed": false,
        "children": [
          {
            "id": "cmd_main",
            "type": "list",
            "x": 0,
            "y": 0,
            "width": 240,
            "maxCols": 1,
            "items": [
              { "name": "아이템",    "symbol": "item",      "enabled": true  },
              { "name": "스킬",     "symbol": "skill",     "enabled": true  },
              { "name": "장비",     "symbol": "equip",     "enabled": true  },
              { "name": "상태",     "symbol": "status",    "enabled": true  },
              { "name": "대형",     "symbol": "formation", "enabled": false },
              { "name": "옵션",     "symbol": "options",   "enabled": true  },
              { "name": "세이브",   "symbol": "save",      "enabled": true  },
              { "name": "게임 종료", "symbol": "gameEnd",   "enabled": true  }
            ],
            "handlers": {
              "item":      { "action": "gotoScene", "target": "Scene_Item" },
              "skill":     { "action": "script", "code": "$gameParty.setMenuActor($gameParty.members()[0]); SceneManager.push(Scene_Skill);" },
              "equip":     { "action": "script", "code": "$gameParty.setMenuActor($gameParty.members()[0]); SceneManager.push(Scene_Equip);" },
              "status":    { "action": "script", "code": "$gameParty.setMenuActor($gameParty.members()[0]); SceneManager.push(Scene_Status);" },
              "options":   { "action": "gotoScene", "target": "Scene_Options" },
              "save":      { "action": "gotoScene", "target": "Scene_Save" },
              "gameEnd":   { "action": "gotoScene", "target": "Scene_GameEnd" },
              "cancel":    { "action": "popScene" }
            }
          },
          {
            "id": "gold_win",
            "type": "panel",
            "x": 0,
            "y": 552,
            "width": 240,
            "height": 72,
            "windowed": true,
            "children": [
              {
                "id": "gold_label",
                "type": "label",
                "x": 6,
                "y": 6,
                "width": 192,
                "height": 36,
                "text": "{gold}G",
                "align": "right"
              }
            ]
          },
          {
            "id": "status_panel",
            "type": "panel",
            "x": 240,
            "y": 0,
            "width": 576,
            "height": 624,
            "windowed": true,
            "children": [
              { "id": "face0",  "type": "actorFace", "x": 7,   "y": 1,   "width": 144, "height": 144, "actorIndex": 0 },
              { "id": "name0",  "type": "label",     "x": 194, "y": 2,   "width": 174, "height": 36,  "text": "{actor[0].name}" },
              { "id": "class0", "type": "label",     "x": 374, "y": 2,   "width": 166, "height": 36,  "text": "{actor[0].class}" },
              { "id": "level0", "type": "label",     "x": 194, "y": 38,  "width": 174, "height": 36,  "text": "Lv.{actor[0].level}" },
              { "id": "hp0",    "type": "gauge",     "x": 374, "y": 38,  "width": 166, "height": 36,  "gaugeType": "hp", "actorIndex": 0 },
              { "id": "mp0",    "type": "gauge",     "x": 374, "y": 74,  "width": 166, "height": 36,  "gaugeType": "mp", "actorIndex": 0 },

              { "id": "sep0",   "type": "separator", "x": 0,   "y": 154, "width": 540, "height": 4 },

