              { "id": "level1", "type": "label",     "x": 194, "y": 194, "width": 174, "height": 36,  "text": "Lv.{actor[1].level}" },
              { "id": "hp1",    "type": "gauge",     "x": 374, "y": 194, "width": 166, "height": 36,  "gaugeType": "hp", "actorIndex": 1 },
