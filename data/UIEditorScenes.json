{
  "scenes": {
    "menu_v2": {
      "id": "menu_v2",
      "displayName": "게임 메뉴",
      "baseScene": "MenuBase",
      "formatVersion": 2,
      "prepareArgs": [],
      "navigation": {
        "defaultFocus": "cmd_main",
        "cancelWidget": "cmd_main",
        "focusOrder": [
          "cmd_main",
          "actor_list"
        ]
      },
      "root": {
        "id": "root",
        "type": "panel",
        "x": 0,
        "y": 0,
        "width": 816,
        "height": 624,
        "windowed": false,
        "children": [
          {
            "id": "cmd_main",
            "type": "list",
            "x": 0,
            "y": 0,
            "width": 240,
            "maxCols": 1,
            "items": [
              {
                "name": "아이템",
                "symbol": "item",
                "enabled": true
              },
              {
                "name": "스킬",
                "symbol": "skill",
                "enabled": true
              },
              {
                "name": "장비",
                "symbol": "equip",
                "enabled": true
              },
              {
                "name": "상태",
                "symbol": "status",
                "enabled": true
              },
              {
                "name": "대형",
                "symbol": "formation",
                "enabledCondition": "$gameParty.size() >= 2 && $gameSystem.isFormationEnabled()"
              },
              {
                "name": "옵션",
                "symbol": "options",
                "enabled": true
              },
              {
                "name": "세이브",
                "symbol": "save",
                "enabledCondition": "$gameSystem.isSaveEnabled()"
              },
              {
                "name": "게임 종료",
                "symbol": "gameEnd",
                "enabled": true
              }
            ],
            "handlers": {
              "item": {
                "action": "gotoScene",
                "target": "Scene_Item"
              },
              "skill": {
                "action": "selectActor",
                "widget": "actor_list",
                "thenAction": {
                  "action": "gotoScene",
                  "target": "Scene_Skill"
                }
              },
              "equip": {
                "action": "selectActor",
                "widget": "actor_list",
                "thenAction": {
                  "action": "gotoScene",
                  "target": "Scene_Equip"
                }
              },
              "status": {
                "action": "selectActor",
                "widget": "actor_list",
                "thenAction": {
                  "action": "gotoScene",
                  "target": "Scene_Status"
                }
              },
              "formation": {
                "action": "formation",
                "widget": "actor_list"
              },
              "options": {
                "action": "gotoScene",
                "target": "Scene_Options"
              },
              "save": {
                "action": "gotoScene",
                "target": "Scene_Save"
              },
              "gameEnd": {
                "action": "gotoScene",
                "target": "Scene_GameEnd"
              },
              "cancel": {
                "action": "popScene"
              }
            }
          },
          {
            "id": "gold_win",
            "type": "panel",
            "x": 0,
            "y": 552,
            "width": 240,
            "height": 72,
            "windowed": true,
            "children": [
