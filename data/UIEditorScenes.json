{
  "scenes": {
    "menu_v2": {
      "id": "menu_v2",
      "displayName": "위젯 트리 메뉴 (v2)",
      "baseScene": "MenuBase",
      "formatVersion": 2,
      "prepareArgs": [],
      "navigation": {
        "defaultFocus": "cmd_main",
        "cancelWidget": "cmd_main",
        "focusOrder": [
          "cmd_main"
        ]
      },
      "root": {
        "id": "root",
        "type": "panel",
        "x": 0,
        "y": 0,
        "width": 816,
        "height": 624,
        "windowed": false,
        "children": [
          {
            "id": "cmd_main",
            "type": "list",
            "x": 0,
            "y": 0,
            "width": 240,
            "maxCols": 1,
            "items": [
              {
                "name": "아이템",
                "symbol": "item",
                "enabled": true
              },
              {
                "name": "닫기",
                "symbol": "cancel",
                "enabled": true
              }
            ],
            "handlers": {
              "item": {
                "action": "gotoScene",
                "target": "Scene_Item"
              },
              "cancel": {
                "action": "popScene"
              }
            }
          },
          {
            "id": "status_panel",
            "type": "panel",
            "x": 240,
            "y": 0,
            "width": 576,
            "height": 400,
            "windowed": true,
            "children": [
              {
                "id": "face",
                "type": "actorFace",
                "x": 0,
                "y": 0,
                "width": 144,
                "height": 144,
                "actorIndex": 0
              },
              {
                "id": "name_lbl",
                "type": "label",
                "x": 160,
                "y": 10,
                "width": 200,
                "height": 36,
                "text": "{actor[0].name}"
              },
              {
                "id": "hp_bar",
                "type": "gauge",
                "x": 160,
                "y": 50,
                "width": 200,
                "height": 36,
                "gaugeType": "hp",
                "actorIndex": 0
              },
              {
                "id": "greeting",
                "type": "label",
                "x": 160,
                "y": 90,
                "width": 200,
                "height": 36,
                "text": "소지금: {gold}G"
              }
            ]
          }
        ]
      }
    }
  }
}