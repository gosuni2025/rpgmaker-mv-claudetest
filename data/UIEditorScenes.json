              {
                "name": "아이템",
                "symbol": "item",
                "enabled": true
              },
              {
                "name": "스킬",
                "symbol": "skill",
                "enabled": true
              },
              {
                "name": "장비",
                "symbol": "equip",
                "enabled": true
              },
              {
                "name": "상태",
                "symbol": "status",
                "enabled": true
              },
              {
                "name": "대형",
                "symbol": "formation",
                "enabledCondition": "$gameParty.size() >= 2 && $gameSystem.isFormationEnabled()"
              },
              {
                "name": "옵션",
                "symbol": "options",
                "enabled": true
              },
              {
                "name": "세이브",
                "symbol": "save",
                "enabledCondition": "$gameSystem.isSaveEnabled()"
              },
              {
                "name": "게임 종료",
                "symbol": "gameEnd",
                "enabled": true
              }
            ],
            "handlers": {
              "item": {
                "action": "gotoScene",
                "target": "Scene_Item"
              },
              "skill": {
                "action": "selectActor",
                "widget": "actor_select",
                "thenAction": {
                  "action": "gotoScene",
                  "target": "Scene_Skill"
                }
              },
              "equip": {
                "action": "selectActor",
                "widget": "actor_select",
                "thenAction": {
                  "action": "gotoScene",
                  "target": "Scene_Equip"
                }
              },
              "status": {
                "action": "selectActor",
