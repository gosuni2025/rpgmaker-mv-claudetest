                "thenAction": {
                  "action": "gotoScene",
                  "target": "Scene_Status"
                }
              },
              "formation": {
                "action": "formation",
                "widget": "actor_select"
              },
              "options": {
                "action": "gotoScene",
                "target": "Scene_Options"
              },
              "save": {
                "action": "gotoScene",
                "target": "Scene_Save"
              },
              "gameEnd": {
                "action": "gotoScene",
                "target": "Scene_GameEnd"
              },
              "cancel": {
