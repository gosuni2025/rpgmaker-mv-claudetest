                "y": 50,
                "width": 200,
                "height": 36,
                "gaugeType": "hp",
                "actorIndex": 0
              },
              {
                "id": "greeting",
                "type": "label",
                "x": 160,
                "y": 90,
                "width": 200,
                "height": 36,
                "text": "소지금: {gold}G"
              }
            ]
          }
        ]
      }
    }
  }
}
