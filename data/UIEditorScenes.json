              { "id": "hp3",    "type": "gauge",     "x": 374, "y": 506, "width": 166, "height": 36,  "gaugeType": "hp", "actorIndex": 3 },
              { "id": "mp3",    "type": "gauge",     "x": 374, "y": 542, "width": 166, "height": 36,  "gaugeType": "mp", "actorIndex": 3 }
