{
  "scenes": {
    "menu_v2": {
      "id": "menu_v2",
      "displayName": "위젯 트리 메뉴 (v2)",
      "baseScene": "MenuBase",
      "formatVersion": 2,
      "prepareArgs": [],
      "navigation": {
        "defaultFocus": "cmd_main",
        "cancelWidget": "cmd_main",
        "focusOrder": ["cmd_main", "actor_list"]
      },
      "root": {
        "id": "root",
        "type": "panel",
        "x": 0,
        "y": 0,
        "width": 816,
        "height": 624,
        "windowed": false,
        "children": [
          {
            "id": "cmd_main",
            "type": "list",
            "x": 0,
            "y": 0,
            "width": 240,
            "maxCols": 1,
            "items": [
              { "name": "아이템",    "symbol": "item",      "enabled": true },
              { "name": "스킬",     "symbol": "skill",     "enabled": true },
              { "name": "장비",     "symbol": "equip",     "enabled": true },
              { "name": "상태",     "symbol": "status",    "enabled": true },
              { "name": "대형",     "symbol": "formation", "enabledCondition": "$gameParty.size() >= 2 && $gameSystem.isFormationEnabled()" },
              { "name": "옵션",     "symbol": "options",   "enabled": true },
              { "name": "세이브",   "symbol": "save",      "enabledCondition": "$gameSystem.isSaveEnabled()" },
              { "name": "게임 종료", "symbol": "gameEnd",   "enabled": true }
            ],
            "handlers": {
              "item":      { "action": "gotoScene",  "target": "Scene_Item" },
              "skill":     { "action": "selectActor", "widget": "actor_list", "thenAction": { "action": "gotoScene", "target": "Scene_Skill" } },
              "equip":     { "action": "selectActor", "widget": "actor_list", "thenAction": { "action": "gotoScene", "target": "Scene_Equip" } },
              "status":    { "action": "selectActor", "widget": "actor_list", "thenAction": { "action": "gotoScene", "target": "Scene_Status" } },
              "formation": { "action": "formation",  "widget": "actor_list" },
              "options":   { "action": "gotoScene",  "target": "Scene_Options" },
              "save":      { "action": "gotoScene",  "target": "Scene_Save" },
              "gameEnd":   { "action": "gotoScene",  "target": "Scene_GameEnd" },
              "cancel":    { "action": "popScene" }
            }
          },
          {
            "id": "gold_win",
            "type": "panel",
            "x": 0,
            "y": 552,
            "width": 240,
            "height": 72,
            "windowed": true,
            "children": [
              {
                "id": "gold_label",
                "type": "label",
                "x": 6,
                "y": 6,
                "width": 192,
                "height": 36,
                "text": "{gold}G",
                "align": "right"
              }
            ]
          },
          {
            "id": "actor_list",
            "type": "actorList",
            "x": 240,
            "y": 0,
            "width": 576,
            "height": 624,
            "numVisibleRows": 4
          }
        ]
      }
    },
    "options": {
      "id": "options",
      "displayName": "옵션 씬 (위젯)",
      "baseScene": "MenuBase",
      "formatVersion": 2,
      "prepareArgs": [],
      "navigation": {
        "defaultFocus": "opts",
        "cancelWidget": "opts",
        "focusOrder": ["opts"]
      },
      "root": {
        "id": "root",
        "type": "panel",
        "x": 0,
        "y": 0,
        "width": 816,
        "height": 624,
        "windowed": false,
        "children": [
          {
            "id": "opts",
            "type": "options",
            "x": 208,
            "y": 0,
            "width": 400,
            "options": [
              { "name": "항상 대시",       "symbol": "alwaysDash" },
              { "name": "커맨드 기억",     "symbol": "commandRemember" },
              { "name": "BGM 볼륨",        "symbol": "bgmVolume" },
              { "name": "BGS 볼륨",        "symbol": "bgsVolume" },
              { "name": "ME 볼륨",         "symbol": "meVolume" },
              { "name": "SE 볼륨",         "symbol": "seVolume" }
            ]
          }
        ]
      }
    }
  }
}
