        ]
      },
      "root": {
        "id": "root",
        "type": "panel",
        "x": 0,
        "y": 0,
        "width": 816,
        "height": 624,
        "windowed": false,
        "children": [
          {
            "id": "cmd_main",
            "type": "list",
            "x": 0,
            "y": 0,
            "width": 240,
            "maxCols": 1,
            "items": [
              {
                "name": "아이템",
                "symbol": "item",
                "enabled": true
              },
              {
                "name": "닫기",
                "symbol": "cancel",
                "enabled": true
              }
            ],
            "handlers": {
              "item": {
                "action": "gotoScene",
                "target": "Scene_Item"
              },
              "cancel": {
                "action": "popScene"
              }
            }
          },
          {
            "id": "status_panel",
            "type": "panel",
            "x": 240,
            "y": 0,
            "width": 576,
            "height": 400,
            "windowed": true,
            "children": [
              {
                "id": "face",
